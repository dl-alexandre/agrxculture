---
export interface CLITool {
  id: string;
  name: string;
  tagline: string;
  description: string;
  commands: string[];
  tech: string[];
  features: string[];
  github: string;
  sampleCommand: string;
  sampleOutput: string;
}

interface Props {
  tool: CLITool;
}

const { tool } = Astro.props;
---

<article class="cli-card" id={tool.id}>
  <!-- Terminal window chrome -->
  <div class="terminal-chrome">
    <div class="terminal-dots">
      <span class="dot dot-red"></span>
      <span class="dot dot-yellow"></span>
      <span class="dot dot-green"></span>
    </div>
    <div class="terminal-title">{tool.name}</div>
    <div class="terminal-spacer"></div>
  </div>

  <!-- Terminal body with sample command/output -->
  <div class="terminal-body">
    <div class="terminal-line">
      <span class="terminal-prompt">$</span>
      <span class="terminal-cmd">{tool.sampleCommand.replace('$ ', '')}</span>
    </div>
    <pre class="terminal-output">{tool.sampleOutput}</pre>
  </div>

  <!-- Card content below terminal -->
  <div class="card-content">
    <h3 class="card-title">{tool.name}</h3>
    <p class="card-tagline">{tool.tagline}</p>
    <p class="card-description">{tool.description}</p>

    <!-- Features checklist -->
    <ul class="feature-list">
      {tool.features.map((feature) => (
        <li class="feature-item">
          <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{feature}</span>
        </li>
      ))}
    </ul>

    <!-- Command chips -->
    <div class="command-chips">
      {tool.commands.map((cmd) => (
        <code class="command-chip">{cmd}</code>
      ))}
    </div>

    <!-- Tech badges -->
    <div class="tech-badges">
      {tool.tech.map((t) => (
        <span class="tech-badge">{t}</span>
      ))}
    </div>

    <!-- GitHub CTA -->
    <a
      href={tool.github}
      class="github-cta"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`View ${tool.name} on GitHub`}
    >
      <svg class="github-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
      </svg>
      View on GitHub
      <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</article>

<style>
  .cli-card {
    background: var(--color-terminal-surface);
    border: 1px solid var(--color-terminal-border);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .cli-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
  }

  /* Terminal Chrome */
  .terminal-chrome {
    display: flex;
    align-items: center;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-terminal-bg);
    border-bottom: 1px solid var(--color-terminal-border);
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-red { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green { background: #28c840; }

  .terminal-title {
    flex: 1;
    text-align: center;
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    color: var(--color-terminal-text-muted);
  }

  .terminal-spacer {
    width: 54px; /* Balance the dots */
  }

  /* Terminal Body */
  .terminal-body {
    padding: var(--space-lg);
    background: var(--color-terminal-bg);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
    line-height: 1.6;
    overflow-x: auto;
  }

  .terminal-line {
    display: flex;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .terminal-prompt {
    color: var(--color-terminal-green);
    font-weight: 700;
    user-select: none;
  }

  .terminal-cmd {
    color: var(--color-terminal-text);
  }

  .terminal-output {
    margin: 0;
    color: var(--color-terminal-text-muted);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    line-height: 1.7;
    white-space: pre;
  }

  /* Card Content */
  .card-content {
    padding: var(--space-xl);
  }

  .card-title {
    font-family: var(--font-family-display);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-terminal-text);
    margin: 0 0 var(--space-xs);
  }

  .card-tagline {
    font-size: var(--font-size-base);
    color: var(--color-terminal-green);
    margin: 0 0 var(--space-lg);
    font-weight: var(--font-weight-medium);
  }

  .card-description {
    font-size: var(--font-size-sm);
    color: var(--color-terminal-text-muted);
    line-height: 1.7;
    margin: 0 0 var(--space-xl);
  }

  /* Features */
  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: var(--font-size-sm);
    color: var(--color-terminal-text);
    line-height: 1.4;
  }

  .check-icon {
    color: var(--color-terminal-green);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Command Chips */
  .command-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .command-chip {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-terminal-bg);
    color: var(--color-terminal-amber);
    border: 1px solid var(--color-terminal-border);
    border-radius: var(--border-radius-sm);
    white-space: nowrap;
  }

  /* Tech Badges */
  .tech-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .tech-badge {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    padding: var(--space-xs) var(--space-sm);
    background: rgba(56, 139, 253, 0.1);
    color: var(--color-terminal-blue);
    border: 1px solid rgba(56, 139, 253, 0.2);
    border-radius: var(--border-radius-full);
  }

  /* GitHub CTA */
  .github-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-xl);
    background: transparent;
    color: var(--color-terminal-text);
    border: 1px solid var(--color-terminal-border);
    border-radius: var(--border-radius-md);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-sm);
    transition: all var(--transition-normal);
    min-height: var(--touch-target-min);
  }

  .github-cta:hover {
    background: var(--color-terminal-bg);
    border-color: var(--color-terminal-text-muted);
    color: var(--color-terminal-text);
  }

  .github-icon {
    flex-shrink: 0;
  }

  .arrow-icon {
    transition: transform var(--transition-fast);
  }

  .github-cta:hover .arrow-icon {
    transform: translateX(3px);
  }

  /* Responsive */
  @media (max-width: 479px) {
    .terminal-body {
      padding: var(--space-md);
      font-size: var(--font-size-xs);
    }

    .card-content {
      padding: var(--space-lg);
    }

    .card-title {
      font-size: var(--font-size-xl);
    }

    .command-chips {
      gap: var(--space-xs);
    }

    .command-chip {
      font-size: 0.65rem;
    }

    .github-cta {
      width: 100%;
      justify-content: center;
      min-height: var(--touch-target-comfortable);
    }
  }

  @media (min-width: 480px) and (max-width: 767px) {
    .card-content {
      padding: var(--space-lg);
    }

    .github-cta {
      min-height: var(--touch-target-comfortable);
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .cli-card {
      transition: none;
    }

    .cli-card:hover {
      transform: none;
    }

    .arrow-icon,
    .github-cta {
      transition: none;
    }
  }
</style>
